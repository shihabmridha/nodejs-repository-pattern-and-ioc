{
    "compilerOptions": {
        "target": "ESNext",
        "module": "node16",
        "moduleResolution": "node16",
        "outDir": "./build",
        "lib": [
            "ESNext"
        ],
        "strict": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "experimentalDecorators": true,
    },
    "include": [
        "src/**/*",
        "tests"
    ]
}